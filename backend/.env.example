# Copy this file to ".env" in the backend/ folder and fill in real values.

# MongoDB connection string.
# Local:  mongodb://127.0.0.1:27017/nomadnest
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/nomadnest
MONGO_URI=mongodb://127.0.0.1:27017/nomadnest

# Any long random string — used to sign JWT auth tokens.
JWT_SECRET=change_this_to_a_long_random_secret

# Port the API server listens on.
PORT=5000

# URL of your deployed frontend (used for CORS in production).
# Not required for local development.
FRONTEND_URL=

NODE_ENV=development
